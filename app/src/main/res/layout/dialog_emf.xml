<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.spiritbox.app.EmfGaugeView
        android:id="@+id/emfGauge"
        android:layout_width="match_parent"
        android:layout_height="130dp" />

    <com.spiritbox.app.EmfTrendView
        android:id="@+id/emfTrend"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/emfReadout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textSize="40sp"
        android:textStyle="bold"
        tools:text="52.4 mG" />

    <TextView
        android:id="@+id/emfHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/emf_dialog_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/emfCorrTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/emf_corr_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emfCorrInfoBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/emf_corr_info_cd"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/emf_corr_info_btn"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_dim"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <com.spiritbox.app.EmfCorrelationView
        android:id="@+id/emfCorr"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/emfCorrStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="0 eventos combinados" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emfMapBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/emf_map_btn"
        app:cornerRadius="24dp" />
</LinearLayout>