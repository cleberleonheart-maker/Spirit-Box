    <string name="emf_status_sensor_blocked">Localização ok, mas o magnetômetro não entrega leitura. Se a bateria estiver otimizada, o sistema segura o sensor.</string>
    <string name="emf_status_no_magnetometer">Este aparelho não expõe magnetômetro — o mapa de hotspots não funciona aqui.</string>
    <string name="emf_status_uncalibrated">Usando o sensor sem calibração (o aparelho não expõe o calibrado). Leituras podem variar mais com a orientação.</string>
